<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless bridge: compiles the SAME pure-layer .cs files the Unity Test Runner builds
    (asmdef Gaffer.Tests), so `dotnet test` and Unity never diverge. Only framework-free
    production code is included; anything touching UnityEngine (Infrastructure, Presentation,
    Composition, Editor) stays OUT — which also *enforces* that Common/Domain/Application remain
    framework-free (they would not compile here otherwise). LangVersion is pinned to Unity 6's
    C# 9 so the bridge rejects anything Unity's compiler would (e.g. file-scoped namespaces).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Assets/_Project/Scripts/Common/**/*.cs" />
    <Compile Include="../Assets/_Project/Scripts/Domain/**/*.cs" />
    <Compile Include="../Assets/_Project/Scripts/Application/**/*.cs" />
    <!-- Pure adapter assemblies: framework-free, so they belong in the bridge (ARCHITECTURE §1).
         UserData is the shipped save serializer + file store; Tools/SeasonHarness is the
         believability instrument, editor-only but pure C#. -->
    <Compile Include="../Assets/_Project/Scripts/UserData/**/*.cs" />
    <Compile Include="../Assets/_Project/Scripts/Tools/SeasonHarness/**/*.cs" />
    <!-- The authored player-facing copy. It lives in Infrastructure because words are not the pure
         core's business (NON-NEGOTIABLE #8) but the file itself is framework-free, and the guard that
         matters — every key DramaCatalog hands out has words in every shipped locale — has to run
         headless rather than only when someone opens Unity. Named file by file, NOT a wildcard: the
         rest of Infrastructure touches UnityEngine and must stay out, and adding `using UnityEngine`
         to this one is meant to break this build loudly. -->
    <Compile Include="../Assets/_Project/Scripts/Infrastructure/Localization/GameStrings.cs" />
    <!-- Same rule, other side of the line: Presentation references UnityEngine and stays out, but this
         file does not, and the rule it holds — ART_STYLE §4.1's brightness ramp, which every screen bands
         numbers by — has to agree with itself across screens or the eye stops trusting brightness to mean
         anything. Named file by file, NOT a wildcard, for exactly the reason GameStrings is: adding
         `using UnityEngine` to it is meant to break this build loudly. -->
    <Compile Include="../Assets/_Project/Scripts/Presentation/Squad/AbilityBand.cs" />
    <Compile Include="../Assets/_Project/Scripts/Presentation/UiTextKeys.cs" />
    <Compile Include="../Assets/_Project/Scripts/Presentation/Squad/PitchBand.cs" />
    <Compile Include="../Assets/_Project/Scripts/Presentation/UiWords.cs" />
    <Compile Include="../Assets/_Project/Scripts/Presentation/Matchday/MomentLine.cs" />
    <Compile Include="../Assets/_Project/Scripts/Presentation/Matchday/MatchBeats.cs" />
    <Compile Include="../Assets/_Project/Scripts/Presentation/Season/TableZones.cs" />
    <Compile Include="../Assets/_Project/Scripts/Presentation/UiMoney.cs" />
    <Compile Include="../Assets/_Project/Scripts/Presentation/Market/Affordability.cs" />
    <Compile Include="../Assets/_Project/Scripts/Presentation/Market/MarketList.cs" />
    <Compile Include="../Assets/_Project/Scripts/Presentation/Market/MarketSort.cs" />
    <Compile Include="../Assets/_Project/Scripts/Presentation/Market/AgeBand.cs" />
    <Compile Include="../Assets/_Project/Scripts/Presentation/Drama/DramaLines.cs" />
    <Compile Include="../Assets/_Project/Scripts/Tests/EditMode/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <!-- Same JSON library the Unity build uses (com.unity.nuget.newtonsoft-json), so the save
         round-trip test exercises the exact serializer the game ships, headless. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
