/*
    GAFFER — the theme. ART_STYLE §2 and §4.1, and the only place a colour is written down.

    "Matchday Broadcast Graphics": the interface is the broadcast package of a match you manage but never
    watch. Night-pitch teal ground, one broadcast-magenta accent, condensed sporting type.

    THE RULE THAT MATTERS MOST: one accent, and no second bright colour (semantics excepted). Everything
    else is built out of a rich neutral base — depth comes from borders and space, never from gradients or
    a pile of shadows. Adding a second bright hue here is the change that would make this look like every
    other dark-mode game, and it is the one thing ART_STYLE forbids by name.

    Nothing outside this file writes a hex. The C# side names BANDS (Presentation/Squad/AbilityBand.cs)
    and the classes below give them their brightness, so retuning the palette never touches code.
*/

/*
    The tokens hang off .theme rather than :root, and that is deliberate. :root resolves only if the
    sheet is attached to the panel's own root; a class travels with whatever element wears it, so a
    screen hosted inside an editor window, a nested panel or a test harness gets the same palette
    without anyone remembering where to attach the sheet. SquadScreen adds .theme next to .screen.
*/
.theme {
    /* --- ground ------------------------------------------------------------------------------------ */
    --pitch: #0C1B1A;
    --pitch-raised: #122624;
    --pitch-line: #1E3733;

    /* --- ink --------------------------------------------------------------------------------------- */
    --chalk: #EAF2EE;
    --muted: #7C938C;

    /* --- the signature ----------------------------------------------------------------------------- */
    --accent: #FF2E7E;

    /* --- semantics: the ONLY sanctioned second colours, and only in a result context ---------------- */
    --win: #2FD48A;
    --loss: #FF5A4D;
    --draw: #E7B84B;

    /* --- the brightness ramp (ART_STYLE §4.1) ------------------------------------------------------
       Value magnitude reads as BRIGHTNESS against the single accent — the job FM does with a second
       green, done here without one. Only the top band burns accent, which is what keeps it meaning
       something. The bands themselves are decided in C# so every screen agrees; these are their looks. */
    --value-elite: #FF2E7E;
    --value-strong: #EAF2EE;
    --value-fair: #9DAAA4;
    --value-weak: #7C938C;
    --value-negligible: #46564F;

    /* --- size ---------------------------------------------------------------------------------------
       EVERYTHING HERE IS IN REFERENCE PIXELS, and the reference is a 1080x1920 phone. That is the trap
       this design system fell into once and must not again: 1080 physical pixels is about 400 logical
       points, so a 15px font — a perfectly ordinary desktop size — renders at roughly 6pt in the hand
       and cannot be read. The rule of thumb is that a number which looks right on a monitor is between
       two and three times too small here.

       So: body text is 30, not 12. A tap target is 110, not 44 — 44 is the guideline in POINTS, and at
       this reference that is 110 pixels. If these are ever retuned, retune them together: the ramp only
       reads as a hierarchy while the steps keep their ratios. */
    --text-headline: 52px;
    --text-title: 34px;
    --text-body: 30px;
    --text-label: 22px;
    --text-small: 20px;

    --space-xs: 8px;
    --space-s: 16px;
    --space-m: 32px;
    --space-l: 48px;
    --space-xl: 80px;

    --tap-min: 110px;
    --row-height: 120px;
    --slot-width: 165px;
}

/* ----- ground --------------------------------------------------------------------------------------- */

.screen {
    flex-grow: 1;
    background-color: var(--pitch);
    /* A phone held upright: the screen fills it and lays its regions out top to bottom. */
    height: 100%;
    flex-direction: column;
    padding-top: var(--space-m);
    padding-bottom: var(--space-m);
    padding-left: var(--space-m);
    padding-right: var(--space-m);
}

/* A card holds its size by default. Only the one marked --grow gives and takes, which is what keeps the
   header and the actions where the manager left them instead of squashing as the squad changes size. */
.card {
    flex-shrink: 0;
    background-color: var(--pitch-raised);
    border-left-color: var(--pitch-line);
    border-right-color: var(--pitch-line);
    border-top-color: var(--pitch-line);
    border-bottom-color: var(--pitch-line);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    padding-top: var(--space-m);
    padding-bottom: var(--space-m);
    padding-left: var(--space-m);
    padding-right: var(--space-m);
    margin-bottom: var(--space-m);
}

/* The header's bottom line: the shape on the left, the mode toggle on the right. */
.header__strip {
    flex-direction: row;
    align-items: center;
    margin-top: var(--space-s);
}

/* ----- lists -----------------------------------------------------------------------------------------
   A row is a tap target first and a line of data second. 56px clears the 44px minimum with room for the
   separator, and the separator is a hairline of --pitch-line rather than a box: depth from lines and
   space, never from shadows (ART_STYLE §5). */

.row {
    flex-direction: row;
    align-items: center;
    height: var(--row-height);
    flex-shrink: 0;
    padding-left: var(--space-s);
    padding-right: var(--space-s);
    border-bottom-width: 2px;
    border-bottom-color: var(--pitch-line);
}

/* Press feedback. A tap with no acknowledgement reads as a tap that did not register — the player
   presses again, and now the game has heard two.

   NO :hover ON A ROW, and that is a scrolling fix rather than a style choice. A phone has no hover, and
   on a desktop every row that slides under the pointer during a scroll enters and leaves the hover state
   — each one starting a 90ms colour transition. A list of twenty doing that at once is the shimmer that
   reads as the scroll "juddering". Press feedback stays, because a press is a real event; hovering is
   the pointer standing still while the world moves. */
.row:active {
    background-color: rgba(255, 46, 126, 0.14);
}

.row {
    transition-property: background-color;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.button:hover {
    background-color: var(--pitch-line);
}

.button:active {
    scale: 0.97 0.97;
}

.button {
    transition-property: background-color, scale;
    transition-duration: 90ms, 90ms;
    transition-timing-function: ease-out, ease-out;
}

/* Fixed height, no wrapping. A name that wrapped would change the row's height, which changes whether a
   scrollbar is needed, which changes the width, which re-wraps the name — a layout loop that shows up as
   the list vibrating. Rows in a virtualised or long list must have a height that does not depend on their
   content. */
.row__name {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    color: var(--chalk);
    font-size: var(--text-body);
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.row__role {
    width: 100px;
    color: var(--muted);
    font-size: var(--text-label);
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-left;
}

.row__rating {
    width: 90px;
    font-size: var(--text-title);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

/* What playing out of position costs, spelled out beside the number it was taken out of. Muted and small
   on purpose: the rating is the figure being compared, and this is its footnote. It is NOT red — the
   semantic colours belong to results (ART_STYLE §2), and a penalty painted like a defeat would make an
   ordinary tactical compromise read as a disaster. */
.row__penalty {
    width: 70px;
    color: var(--muted);
    font-size: var(--text-body);
    -unity-text-align: middle-right;
}

/* ----- the pitch --------------------------------------------------------------------------------------
   A tactics board, not a football pitch: no grass, no lines, no green. The shape reads from where the
   cards SIT, which is the broadcast-graphic way of drawing a formation and keeps the single-accent rule
   intact — a green pitch would be the second bright colour ART_STYLE forbids. */

/* The board FILLS the space it is given and never scrolls. Bands share the height between them, so a
   4-4-2 and a 3-5-2 both fit whatever phone they land on — which is what lets the whole mode be
   gesture-unambiguous: there is nothing here to swipe. */
.pitch {
    flex-grow: 1;
    justify-content: space-around;
    background-color: var(--pitch);
    border-left-color: var(--pitch-line);
    border-right-color: var(--pitch-line);
    border-top-color: var(--pitch-line);
    border-bottom-color: var(--pitch-line);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    padding-top: var(--space-m);
    padding-bottom: var(--space-m);
}

/* A band fills the width whatever it holds, so a back four and a front two both look deliberate. */
.pitch__band {
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    flex-shrink: 1;
}

.slot {
    width: var(--slot-width);
    min-height: var(--tap-min);
    align-items: center;
    justify-content: center;
    background-color: var(--pitch-raised);
    border-left-color: var(--pitch-line);
    border-right-color: var(--pitch-line);
    border-top-color: var(--pitch-line);
    border-bottom-color: var(--pitch-line);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    padding-top: var(--space-xs);
    padding-bottom: var(--space-xs);
    transition-property: background-color, scale;
    transition-duration: 90ms, 90ms;
    transition-timing-function: ease-out, ease-out;
}

.slot:hover {
    background-color: var(--pitch-line);
}

.slot:active {
    scale: 0.96 0.96;
}

/* Picked up. The accent border is the only thing on the board that burns the signature colour, which is
   what makes "this one is in your hand" unmissable at a glance. */
.slot--selected {
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
    background-color: rgba(255, 46, 126, 0.12);
}

.slot__role {
    color: var(--muted);
    font-size: var(--text-small);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.slot__name {
    color: var(--chalk);
    font-size: var(--text-label);
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    width: 100%;
}

.slot__rating {
    font-size: var(--text-title);
    -unity-font-style: bold;
}

/* The cost of standing here, on the tile. The rating above it is ALREADY the charged number — this says
   where the missing points went, so a weaker-looking side can be accounted for rather than merely felt. */
.slot__penalty {
    color: var(--muted);
    font-size: var(--text-small);
}

/* Out of position, on a tile — the same two tiers and the same names the rows use (.row--samline /
   .row--misfit), so a fit means one thing whichever surface the manager happens to be looking at. A
   compromise on the same line gets a quiet edge; anything further gets the edge and a dimming, so a
   genuinely wrong tile is visible from across the board without a second bright colour entering the
   palette. */
.slot--samline {
    border-left-color: var(--pitch-line);
    border-left-width: 5px;
}

.slot--misfit {
    border-left-color: var(--muted);
    border-left-width: 5px;
    opacity: 0.8;
}

/* The card in your hand while you drag. Positioned absolutely against the panel so it draws over
   everything, and deliberately unmistakable: this is the element that tells the manager the gesture
   was heard at all. */
.slot--ghost {
    position: absolute;
    background-color: var(--accent);
    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
    opacity: 0.92;
}

.slot--ghost .slot__name {
    color: var(--pitch);
    -unity-font-style: bold;
}

/* The slot a dragged card came from: emptied-looking, so the board shows where it will go back to. */
.slot--source {
    opacity: 0.35;
}

/* ----- the phone layout -------------------------------------------------------------------------------
   Fixed regions, one scroller. The board must not scroll, because a thing you DRAG on cannot also be a
   thing you swipe on — the same gesture in the same place meaning two things is confusing however it is
   arbitrated. The bench is the only part that can outgrow the screen, so it is the only part that
   scrolls, and the actions stay pinned where a thumb reaches. */

.card--grow {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 220px;
    /* The scroller inside needs a parent that can be smaller than its content, or it never scrolls. */
    overflow: hidden;
}

.bench-scroll {
    flex-grow: 1;
}

/* The drag layer. Absolutely positioned over everything and transparent to touch, so the card in your
   hand never blocks the slot you are aiming at, and never affects the layout it floats above. */
.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ----- the page --------------------------------------------------------------------------------------
   One scroller for the whole screen. The scrollbar is a hairline rather than a control: on a phone the
   drag IS the scroll, and a chrome-heavy bar spends attention on something nobody presses. */

.page {
    flex-grow: 1;
}

.bench-scroll .unity-scroller--vertical,
.page .unity-scroller--vertical {
    width: 10px;
}

.bench-scroll .unity-scroller--vertical .unity-base-slider__dragger,
.page .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--pitch-line);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.bench-scroll .unity-scroller--vertical .unity-base-slider__tracker,
.page .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.bench-scroll .unity-scroller__low-button,
.bench-scroll .unity-scroller__high-button,
.page .unity-scroller__low-button,
.page .unity-scroller__high-button {
    display: none;
}

/* ----- the sheet -------------------------------------------------------------------------------------
   A bottom sheet: the phone answer to "who plays here". It covers the screen, dims what is behind, and
   scrolls freely — with nothing to drag out of it, the list can simply be a list. */

.sheet {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.sheet__scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(6, 14, 13, 0.82);
}

.sheet__panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: 70%;
    background-color: var(--pitch-raised);
    border-top-color: var(--accent);
    border-top-width: 4px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    padding-left: var(--space-m);
    padding-right: var(--space-m);
    padding-top: var(--space-m);
    padding-bottom: var(--space-l);
}

.sheet__scroll {
    flex-grow: 1;
}

/* ----- type ------------------------------------------------------------------------------------------
   Hierarchy is built from size and weight, not from spending colour (ART_STYLE §3). */

.headline {
    color: var(--chalk);
    font-size: var(--text-headline);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.label {
    color: var(--muted);
    font-size: var(--text-label);
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.body {
    color: var(--chalk);
    font-size: var(--text-body);
    white-space: normal;
}

/* Numbers are tabular so columns line up down a squad list. */
.numeric {
    color: var(--chalk);
    font-size: var(--text-body);
    -unity-text-align: middle-right;
}

/* FIT, on a row. One class per tier, and the same four everywhere a row appears — a sheet of candidates
   and the eleven itself differ only in whether the natural mark is applied at all (marking all eleven
   would wash the list in accent and say nothing).

   The wash marks IMPORTANCE, never value — the same rule the role-key row follows (ART_STYLE §4.1/2), so
   brightness stays the only thing that means "how good". Nothing here is red: the semantic colours belong
   to results (ART_STYLE §2), and a tactical compromise painted like a defeat would read as a disaster. */
.row--natural {
    background-color: rgba(255, 46, 126, 0.09);
    border-left-color: var(--accent);
    border-left-width: 5px;
}

.row--samline {
    border-left-color: var(--pitch-line);
    border-left-width: 5px;
}

.row--misfit {
    border-left-color: var(--muted);
    border-left-width: 5px;
    opacity: 0.75;
}

/* The one pairing the game refuses to pick for you — a keeper out of goal, an outfielder in it. Dimmed
   hard rather than reddened, so it reads as "not really an option" instead of "danger". */
.row--wrong {
    opacity: 0.45;
}

/* ----- the brightness ramp -------------------------------------------------------------------------- */

.value--elite {
    color: var(--value-elite);
    -unity-font-style: bold;
}

.value--strong {
    color: var(--value-strong);
    -unity-font-style: bold;
}

.value--fair {
    color: var(--value-fair);
}

.value--weak {
    color: var(--value-weak);
}

.value--negligible {
    color: var(--value-negligible);
}

/* ----- role emphasis (ART_STYLE §4.1/2) ---------------------------------------------------------------
   A row the role is scored on is WASHED, not recoloured: importance is marked, never value. */

.row--key {
    background-color: rgba(255, 46, 126, 0.09);
    border-left-color: var(--accent);
    border-left-width: 5px;
}

/* ----- touch ------------------------------------------------------------------------------------------ */

.tappable {
    min-height: var(--tap-min);
    justify-content: center;
}

.button {
    min-height: var(--tap-min);
    background-color: var(--pitch-raised);
    border-left-color: var(--pitch-line);
    border-right-color: var(--pitch-line);
    border-top-color: var(--pitch-line);
    border-bottom-color: var(--pitch-line);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    color: var(--chalk);
    font-size: var(--text-body);
    padding-left: var(--space-m);
    padding-right: var(--space-m);
}

.button--primary {
    background-color: var(--accent);
    color: var(--pitch);
    -unity-font-style: bold;
}

/* ----- results: the one place a second colour is allowed --------------------------------------------- */

.result--win {
    color: var(--win);
}

.result--loss {
    color: var(--loss);
}

.result--draw {
    color: var(--draw);
}
